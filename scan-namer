#!/bin/bash
# Scan Namer wrapper script - uses uv to run the Python script with dependencies

# Check if uv is installed
if ! command -v uv &> /dev/null; then
    echo "Error: uv is not installed. Please install it first:"
    echo "curl -LsSf https://astral.sh/uv/install.sh | sh"
    exit 1
fi

ROOT="$(cd "$(dirname "$0")" && pwd)"

# Run the Python script with uv (from any directory: config defaults to
# ~/.config/scan-namer/config.json and prompts.json is read from $ROOT)
exec uv run --project "$ROOT" "$ROOT/scan_namer.py" --download ~/Downloads/scans "$@"
